<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="HRDB">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=SQL-HR-01;Initial Catalog=HRSystem</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="EmployeeData">
      <Query>
        <DataSourceName>HRDB</DataSourceName>
        <CommandText>SELECT e.EmployeeId, e.EmployeeName, e.HireDate FROM dbo.Employees e</CommandText>
      </Query>
      <Fields>
        <Field Name="EmployeeId"><DataField>EmployeeId</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="EmployeeName"><DataField>EmployeeName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="HireDate"><DataField>HireDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Department">
      <DataType>String</DataType>
      <DefaultValue><Values><Value>All</Value></Values></DefaultValue>
      <Prompt>Department</Prompt>
    </ReportParameter>
  </ReportParameters>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Tablix Name="EmployeeTablix">
            <DataSetName>EmployeeData</DataSetName>
            <Top>0.25in</Top>
            <Left>0.25in</Left>
            <Height>2in</Height>
            <Width>6in</Width>
            <TablixBody>
              <TablixColumns/>
              <TablixRows>
                <TablixRow>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="t1"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!EmployeeName.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="t2"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!HireDate.Value</Value></TextRun></TextRuns></Paragraph></Paragraphs></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <Group Name="DeptGroup"><GroupExpressions><GroupExpression>=Fields!EmployeeName.Value</GroupExpression></GroupExpressions></Group>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <TablixColumnHierarchy><TablixMembers><TablixMember/></TablixMembers></TablixColumnHierarchy>
          </Tablix>
        </ReportItems>
        <Height>3in</Height>
      </Body>
      <Width>8.5in</Width>
      <Page><PageHeight>11in</PageHeight></Page>
    </ReportSection>
  </ReportSections>
</Report>
